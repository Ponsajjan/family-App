generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Auth {
  id                Int             @id @default(autoincrement())
  mainMemberId      Int?            @unique
  moderatorList     ModeratorList[]
  familyTree        FamilyTree?
  moderatorPassword String
  password          String          @unique
  members           Member[]        @relation("AuthToMember")

  memberAuthId    String? @unique
  moderatorAuthId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id       Int      @id @default(autoincrement())
  authId   Int
  verified Boolean? @default(false)
  name     String

  birthDate  Int?
  birthMonth Int?
  birthYear  Int?

  deceased Boolean @default(false)

  deathDate  Int?
  deathMonth Int?
  deathYear  Int?

  gender              String
  phoneNumber         String?
  birthPlace          String?
  currentAddress      String?          @map("address")
  city                String?
  state               String?
  country             String?
  occupation          String?
  education           String?
  additionalInfo      String?
  pendingVerification RequestDetails[]
  descendant          Boolean          @default(false)
  order               Int              @default(1) // Order of the member in the family tree
  // Family relationships
  fatherId            Int? // Foreign key for father
  motherId            Int? // Foreign key for mother
  partnerId           Int?

  nonDescendantRelation nonDescendantRelation[]

  father Member? @relation("FatherOfChildren", fields: [fatherId], references: [id])
  mother Member? @relation("MotherOfChildren", fields: [motherId], references: [id])

  // get Partner Pair values One-to-many self-referencing relationship
  partner   Member?  @relation("PartnerRelation", fields: [partnerId], references: [id])
  partnerOf Member[] @relation("PartnerRelation") // Opposite relation for partner

  fatherOf Member[] @relation("FatherOfChildren")
  motherOf Member[] @relation("MotherOfChildren")
  auth     Auth     @relation("AuthToMember", fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestDetails {
  id       Int    @id @default(autoincrement())
  authId   Int // for filtering out data
  type     String // editMember, addRelationShip, EditRelationship,
  details  String
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model nonDescendantRelation {
  id           Int     @id @default(autoincrement())
  memberId     Int     @unique
  fatherName   String?
  motherName   String?
  siblingNames String?
  member       Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModeratorList {
  id               Int    @id @default(autoincrement())
  moderatorName    String
  moderatorContact String
  authId           Int
  moderator        Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FamilyTree {
  id                 Int       @id @default(autoincrement())
  authId             Int       @unique
  data               Json? // Nullable since it won't exist during "building" status
  status             String    @default("completed") // "building", "completed", "failed"
  lastBuildStartedAt DateTime? // Track when build started (for timeout detection)
  auth               Auth      @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
