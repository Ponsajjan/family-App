generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Auth {
  id                Int             @id @default(autoincrement())
  forDescendanceOf  String          @unique
  mainMemberId      Int?            @unique
  moderatorList     ModeratorList[]
  moderatorPassword String
  password          String          @unique
  members           Member[]        @relation("AuthToMember")
}

model Member {
  id           Int      @id @default(autoincrement())
  descendantOf String
  verified     Boolean? @default(false)
  name         String

  birthDate  Int?
  birthMonth Int?
  birthYear  Int?

  deceased Boolean @default(false)

  deathDate  Int?
  deathMonth Int?
  deathYear  Int?

  gender              String?
  phoneNumber         String?
  address             String?
  occupation          String?
  education           String?
  pendingVerification RequestDetails[]
  descendant          Boolean          @default(false)
  order               Int              @default(1) // Order of the member in the family tree
  // Family relationships
  fatherId            Int? // Foreign key for father
  motherId            Int? // Foreign key for mother
  partnerId           Int? // Foreign key for partner

  nonDescendantRelation nonDescendantRelation[]

  father Member? @relation("FatherOfChildren", fields: [fatherId], references: [id])
  mother Member? @relation("MotherOfChildren", fields: [motherId], references: [id])

  // get Partner Pair values
  partner   Member?  @relation("PartnerRelation", fields: [partnerId], references: [id])
  partnerOf Member[] @relation("PartnerRelation") // Opposite relation for partner

  // Children having member as father list
  fatherOf Member[] @relation("FatherOfChildren") // Opposite relation for father
  motherOf Member[] @relation("MotherOfChildren") // Opposite relation for mother
  auth     Auth     @relation("AuthToMember", fields: [descendantOf], references: [forDescendanceOf], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestDetails {
  id       Int    @id @default(autoincrement())
  type     String // editMember, addRelationShip, EditRelationship,
  details  String
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model nonDescendantRelation {
  id           Int     @id @default(autoincrement())
  memberId     Int     @unique
  fatherName   String?
  motherName   String?
  siblingNames String?
  member       Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModeratorList {
  id               Int    @id @default(autoincrement())
  moderatorName    String
  moderatorContact String
  authId           Int
  moderator        Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)
}
