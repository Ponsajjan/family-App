// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id                    Int                   @id @default(autoincrement())
  reference_id          String?
  name                  String

  birthDate             Int?
  birthMonth            Int?
  birthYear             Int?

  deceased              Boolean               @default(false)

  deathDate             Int?
  deathMonth            Int?
  deathYear             Int?
  
  gender                String?
  phoneNumber           String?
  address               String?
  occupation            String?
  education             String?
  additionalInfo        MembersAdditionalInfo[]
  descendant            Boolean               @default(false)
  partner               MembersPartner[]
  father                MembersFather[]
  mother                MembersMother[]
  children              MembersChildren[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model MembersPartner {
  id                    Int                   @id @default(autoincrement())
  partner               Member                @relation(fields: [partnerId], references: [id])
  divorced              Boolean               @default(false)
  partnerId             Int
}

model MembersFather {
  id                    Int                   @id @default(autoincrement())
  father                Member                @relation(fields: [fatherId], references: [id])
  fatherId              Int
}

model MembersMother {
  id                    Int                   @id @default(autoincrement())
  mother                Member                @relation(fields: [motherId], references: [id])
  motherId              Int
}

model MembersChildren {
  id                    Int                   @id @default(autoincrement())
  children              Member                @relation(fields: [childrenId], references: [id])
  childrenId            Int
}

model MembersAdditionalInfo {
  id                    Int                   @id @default(autoincrement())
  topic                 String?
  details               String
  member                Member                @relation(fields: [memberId], references: [id])
  memberId              Int
}