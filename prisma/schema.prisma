generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Auth {
  id                Int             @id @default(autoincrement())
  forDescendanceOf  String          @unique
  mainMemberId      Int?            @unique
  moderatorList     ModeratorList[]
  moderatorPassword String
  password          String          @unique
  members           Member[]        @relation("AuthToMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id           Int      @id @default(autoincrement())
  descendantOf String
  verified     Boolean? @default(false)
  name         String

  birthDate  Int?
  birthMonth Int?
  birthYear  Int?

  deceased Boolean @default(false)

  deathDate  Int?
  deathMonth Int?
  deathYear  Int?

  gender              String
  phoneNumber         String?
  address             String?
  occupation          String?
  education           String?
  pendingVerification RequestDetails[]
  descendant          Boolean          @default(false)
  order               Int              @default(1) // Order of the member in the family tree
  // Family relationships
  fatherId            Int? // Foreign key for father
  motherId            Int? // Foreign key for mother

  nonDescendantRelation nonDescendantRelation[]

  father Member? @relation("FatherOfChildren", fields: [fatherId], references: [id])
  mother Member? @relation("MotherOfChildren", fields: [motherId], references: [id])

  // get Partner
  partnerships  Partnership[] @relation("PartnershipsAsMember")
  partneredWith Partnership[] @relation("PartnershipsAsPartner")

  // Children having member as father list
  fatherOf Member[] @relation("FatherOfChildren")
  motherOf Member[] @relation("MotherOfChildren")
  auth     Auth     @relation("AuthToMember", fields: [descendantOf], references: [forDescendanceOf], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestDetails {
  id           Int    @id @default(autoincrement())
  descendantOf String // for filtering out data
  type         String // editMember, addRelationShip, EditRelationship,
  details      String
  memberId     Int
  member       Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model nonDescendantRelation {
  id           Int     @id @default(autoincrement())
  memberId     Int     @unique
  fatherName   String?
  motherName   String?
  siblingNames String?
  member       Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partnership {
  id        Int    @id @default(autoincrement())
  memberId  Int
  partnerId Int
  member    Member @relation("PartnershipsAsMember", fields: [memberId], references: [id])
  partner   Member @relation("PartnershipsAsPartner", fields: [partnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModeratorList {
  id               Int    @id @default(autoincrement())
  moderatorName    String
  moderatorContact String
  authId           Int
  moderator        Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
