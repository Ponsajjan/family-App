generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                Int             @id @default(autoincrement())
  mainMemberId      Int?            @unique
  mainMemberNameRef String?         @unique
  moderatorList     ModeratorList[]
  moderatorPassword String
  password          String          @unique
  members           Member[]        @relation("AuthToMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id       Int      @id @default(autoincrement())
  authId   Int
  verified Boolean? @default(false)
  name     String

  birthDate  Int?
  birthMonth Int?
  birthYear  Int?

  deceased Boolean @default(false)

  deathDate  Int?
  deathMonth Int?
  deathYear  Int?

  gender              String
  phoneNumber         String?
  address             String?
  occupation          String?
  education           String?
  pendingVerification RequestDetails[]
  descendant          Boolean          @default(false)
  order               Int              @default(1) // Order of the member in the family tree
  // Family relationships
  fatherId            Int? // Foreign key for father
  motherId            Int? // Foreign key for mother

  nonDescendantRelation nonDescendantRelation[]

  father Member? @relation("FatherOfChildren", fields: [fatherId], references: [id])
  mother Member? @relation("MotherOfChildren", fields: [motherId], references: [id])

  // Partnerships: Many-to-many relationships with other members
  partnerOf   Partnership[] @relation("PartnerOf") // Partnerships where this member is person1
  partnerWith Partnership[] @relation("PartnerWith") // Partnerships where this member is person2

  // Children having member as father list
  fatherOf  Member[] @relation("FatherOfChildren")
  motherOf  Member[] @relation("MotherOfChildren")
  auth      Auth     @relation("AuthToMember", fields: [authId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table for many-to-many partnerships between members
model Partnership {
  id        Int    @id @default(autoincrement())
  person1Id Int
  person2Id Int
  person1   Member @relation("PartnerOf", fields: [person1Id], references: [id], onDelete: Cascade)
  person2   Member @relation("PartnerWith", fields: [person2Id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([person1Id, person2Id])
}

model RequestDetails {
  id           Int    @id @default(autoincrement())
  descendantOf String // for filtering out data
  type         String // editMember, addRelationShip, EditRelationship,
  details      String
  memberId     Int
  member       Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model nonDescendantRelation {
  id           Int     @id @default(autoincrement())
  memberId     Int     @unique
  fatherName   String?
  motherName   String?
  siblingNames String?
  member       Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModeratorList {
  id               Int    @id @default(autoincrement())
  moderatorName    String
  moderatorContact String
  authId           Int
  moderator        Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
