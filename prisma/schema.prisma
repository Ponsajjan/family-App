// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int             @id @default(autoincrement())
  reference_id          String?
  name                  String
  birthday              DateTime?
  deceased              Boolean         @default(false)
  deathday              DateTime?
  gender                String?
  phoneNumber           String?
  address               String?
  occupation            String?
  education             String?
  additionalInfo        UserAdditionalInfo[]
  descendant            Boolean         @default(false)
  partner               UserPartner[]
  father                UserFather[]
  mother                UserMother[]
  children              UserChildren[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model UserPartner {
  id                    Int             @id @default(autoincrement())
  partner               User            @relation(fields: [partnerId], references: [id])
  partnerId             Int             @unique
}

model UserFather {
  id                  Int             @id @default(autoincrement())
  father              User            @relation(fields: [fatherId], references: [id])
  fatherId            Int             @unique
}

model UserMother {
  id                  Int             @id @default(autoincrement())
  mother              User            @relation(fields: [motherId], references: [id])
  motherId            Int             @unique
}

model UserChildren {
  id                    Int             @id @default(autoincrement())
  children              User            @relation(fields: [childrenId], references: [id])
  childrenId            Int             @unique
}

model UserAdditionalInfo {
  id                    Int               @id @default(autoincrement())
  topic                 String?
  details               String
  user                  User              @relation(fields: [userId], references: [id])
  userId                Int
}